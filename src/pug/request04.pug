extends ./layout/layout
include ./components/breadcrumb.pug
include ./components/stepIndicator.pug

block content
  main.request-page
    .inner-box
      .request-page__top
        +breadcrumb(['홈페이지 제작', '제작신청'])
        .request-page__header
          +stepIndicator(4)
          h2.request-page__title 이관 메뉴 선택

      section.request-section
        span.helper-text * 콘텐츠 현행화 진행 시 #[em.color-red 해당 콘텐츠는 신청 후 00주 내 제공]해야 합니다.
        table.menu-transfer-table
          colgroup
            col(style="width: 20%")
            col(style="width: 10%")
            col(style="width: 20%")
            col(style="width: 10%")
            col(style="width: 20%")
            col(style="width: 10%")
            col(style="width: 10%")
          thead
            tr
              th 메뉴구조
              th 이관여부
              th 구분
              th 비용
              th 설명
              th 삭제
              th 콘텐츠 현행화
          tbody
            // 농협소개
            tr.category-row
              td(colspan="7") 농협소개
            tr
              td.menu-name 인사말
              td 여
              td 일반기능 (인사말 관리)
              td.price 0
              td 기본 제공 메뉴
              td
                label.checkbox-custom
                  input(type="checkbox" checked)
                  span.checkmark
              td
                label.checkbox-custom
                  input(type="checkbox" checked)
                  span.checkmark
            tr
              td.menu-name 연혁
