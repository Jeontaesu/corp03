//- //- ============================================================
//- //- mixin: menuRow
//- //- 매개변수
//- //-   name      {string}  메뉴명
//- //-   transfer  {string}  이관여부 ('여' | '부')
//- //-   type      {string}  구분 (이관불가일 경우 빈 문자열)
//- //-   price     {string}  비용
//- //-   desc      {string}  설명
//- //-   hasDelete {boolean} 삭제 체크박스 표시 여부
//- //-   hasUpdate {boolean} 콘텐츠 현행화 체크박스 표시 여부
//- //-   checked   {object}  { delete: bool, update: bool } 체크 상태
//- //-   id        {string}  아코디언 토글 대상 id (하위 메뉴가 있을 경우)
//- //-   depth     {number}  현재 depth (1~6, 루트는 0으로 간주)
//- //-   parentId  {string}  부모 그룹 id (최상위는 빈 문자열)
//- //- ============================================================
//- mixin menuRow(options)
//-   -
//-     var name      = options.name
//-     var transfer  = options.transfer
//-     var type      = options.type      || ''
//-     var price     = options.price     || '0'
//-     var desc      = options.desc      || ''
//-     var hasDelete = options.hasDelete !== false
//-     var hasUpdate = options.hasUpdate !== false
//-     var checked   = options.checked   || { delete: false, update: false }
//-     var id        = options.id        || ''         // 하위 메뉴가 있으면 토글 id
//-     var depth     = options.depth     || 0          // 0 = 최상위 행
//-     var parentId  = options.parentId  || ''         // 하위 행이면 부모 그룹 id

//-   //- 이관불가 행
//-   if transfer === '부'
//-     tr(class=parentId ? 'accordion-sub depth-' + depth : '' data-group=parentId || undefined)
//-       td.menu-name(class='depth-' + depth)
//-         if depth > 0
//-           span.menu-depth-indent(aria-hidden="true")
//-         | #{name}
//-       td 부
//-       td.color-red(colspan="5") 이관불가

//-   //- 이관 가능 행
//-   else
//-     tr(class=parentId ? 'accordion-sub depth-' + depth : '' data-group=parentId || undefined)
//-       td.menu-name(class='depth-' + depth)
//-         //- 하위 메뉴가 있으면 토글 버튼 추가
//-         if id
//-           button.accordion-toggle(
//-             type="button"
//-             aria-expanded="false"
//-             aria-controls=id
//-             data-target=id
//-           )
//-             span.accordion-toggle__icon(aria-hidden="true")
//-         //- 들여쓰기 인디케이터 (depth 1~6)
//-         if depth > 0
//-           span.menu-depth-indent(aria-hidden="true")
//-         | #{name}
//-       td= transfer
//-       td= type
//-       td.price= price
//-       td= desc
//-       td
//-         if hasDelete
//-           label.checkbox-custom
//-             input(type="checkbox" checked=checked.delete || undefined)
//-             span.checkmark
//-       td
//-         if hasUpdate
//-           label.checkbox-custom
//-             input(type="checkbox" checked=checked.update || undefined)
//-             span.checkmark

