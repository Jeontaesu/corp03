mixin affiliateItem3(modifierClass, name, icon)
	li.affiliate3-card(class=modifierClass)
		a.affiliate3-card__link(href="#")
			span.affiliate3-card__name
				= name
				img.affiliate3-card__chevron(src="../img/icon/main3_icon_chevron.svg", alt="")
			.affiliate3-card__icon
				img(src=icon, alt="")
