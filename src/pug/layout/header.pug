-
    const gnbList = ['사업소개', '윤리경영', '채용안내', '홍보센터'];
    const gnbDepthLists = [
        ['사업 개요', '상호금융', '경제사업', '스마트영농'],
        ['윤리경영 소개', '윤리강령', '청렴 활동', '신고센터'],
        ['채용 안내', '채용 절차', '인사제도', '복리후생'],
        ['공지사항', '보도자료', '갤러리', '농협 소식지']
    ];

header.header(data-js="header")
    .header__inner
        .header__logo
            a(href="#", title="OO농협 메인")
                img.header__logo-mark(src="../img/icon/icon_nh_logo.svg", alt="")
                span.header__logo-text OO농협
        nav.header__gnb
            ul.gnb
                each item in gnbList
                    li.gnb__item
                        a.gnb__link(href="#")= item
        .header__util
            .util
                a.util__link(href="#") 로그인
                span.util__divider
                a.util__link(href="#") 회원가입
            button.util__menu-button(type="button", aria-label="전체메뉴", data-js="gnbButton")
                span.util__menu-bar
    nav.all-gnb
        .all-gnb__category
            each item, i in gnbList
                .all-gnb__category-item
                    strong.all-gnb__title= item
                    .all-gnb__menu
                        ul.menu-list
                            each depthItem in gnbDepthLists[i]
                                li.menu-list__item
                                    a.menu-list__link(href="#")= depthItem
