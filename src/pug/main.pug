extends ./layout/layout
include ./mixin/statCard.pug
include ./mixin/valueCard.pug
include ./mixin/newsItem.pug
include ./mixin/galleryItem.pug
include ./mixin/snsCard.pug
include ./mixin/affiliateItem.pug

block content
	-
		const statCards = [
			{modifierClass: 'history', img: '../img/main/main_stat01.png', label: '역사와 신뢰', num: '20', unit: '년'},
			{modifierClass: 'satisfaction', img: '../img/main/main_stat02.png', label: '고객의 만족', num: '100', unit: '%'},
			{modifierClass: 'sales', img: '../img/main/main_stat03.png', label: '매출과 신뢰', num: '8,000', unit: '억'},
			{modifierClass: 'esg', img: '../img/main/main_stat04.png', label: 'ESG 경영', num: '100', unit: '점'}
		];
		const valueCards = [
			{modifierClass: 'finance', img: '../img/main/main_value01.jpg', icon: '../img/icon/icon_finance.svg', title: '상호금융', desc: '신뢰할 수 있는 금융 서비스를 통한 조합원의 풍요로운 삶 지원'},
			{modifierClass: 'economy', img: '../img/main/main_value02.jpg', icon: '../img/icon/icon_economy.svg', title: '경제사업', desc: '체계적인 유통과 영농 자재 지원을 통한 농가 소득 향상 선도'},
			{modifierClass: 'smart', img: '../img/main/main_value03.jpg', icon: '../img/icon/icon_smartFarm.svg', title: '스마트영농', desc: '첨단 기술과 영농 지원 시스템을 통한 농업의 미래 경쟁력 강화'},
			{modifierClass: 'community', img: '../img/main/main_value04.jpg', icon: '../img/icon/icon_community.svg', title: '지역공헌', desc: '따뜻한 나눔과 복지 사업을 통한 지역 사회와의 동반 성장'}
		];
		const newsList = [
			{month: '2026.07', day: '14', title: '농협중앙회 NH AICC 구축 RFI 설명회 개최', desc: '별도의 금융상품 안내 페이지에서 자세한 상품 정보 및 관련 내용을 확인하실 수 있습니다.'},
			{month: '2026.06', day: '09', title: '연매출 800억 돌파”…유통 혁신으로 부여 농산...', desc: '별도의 금융상품 안내 페이지에서 자세한 상품 정보 및 관련 내용을 확인하실 수 있습니다.'},
			{month: '2026.06', day: '02', title: '2026년 농협 농산물저온유통 센터 구축 지원사...', desc: '별도의 금융상품 안내 페이지에서 자세한 상품 정보 및 관련 내용을 확인하실 수 있습니다.'}
		];
		const galleryList = [
			{img: '../img/main/main3_gallery01.png', title: '농협중앙회, 임직원 대상「청렴온기(淸廉溫氣) 확산 운동」실시', desc: '농협중앙회(회장 강호동)는 지난 7월 28일부터 서울 중구 본관에서 임직원을 대상으로「청렴온기(淸廉溫氣) 확산 운동」을 실시하고 있다고 3일 밝혔다.'},
			{img: '../img/main/main3_gallery02.png', title: '농협몰(NH싱싱몰), 임산부와 태아에게 친환경 농산물 본격 공급', desc: '농협경제지주(농업경제대표이사 김주양)는 국산 농식품 전문 온라인 쇼핑몰인 농협몰(NH싱싱몰)에서 ‘임산부 친환경 농산물 꾸러미’ 주문 서비스를 시작했다고 4일 밝혔다.'}
		];
		const snsCards = [
			{modifierClass: 'instagram', icon: '../img/main/sns_insta.svg', title: 'OO농협 <br>인스타그램'},
			{modifierClass: 'youtube', icon: '../img/main/sns_youtube.svg', title: 'OO농협 <br>유튜브'}
		];
		const affiliateList = [
			{name: 'NH농협', icon: '../img/icon/icon_nh_logo.svg'},
			{name: '농협몰', icon: '../img/icon/icon_shopping_bag.svg'},
			{name: '농림축산식품부', icon: '../img/icon/icon_pig.svg'},
			{name: '친환경인증관리', icon: '../img/icon/ic_sprout.svg'},
			{name: '농산물 가격정보', icon: '../img/icon/icon_price.svg'},
			{name: '농촌진흥청', icon: '../img/icon/icon_speech.svg'},
			{name: '농민신문', icon: '../img/icon/icon_paper.svg'},
			{name: 'NH뱅크', icon: '../img/icon/icon_won.svg'},
			{name: '농협경제지주', icon: '../img/icon/icon_graph.svg'},
			{name: '농업관측정보', icon: '../img/icon/icon_paper.svg'}
		];

	main.main
		//- 히어로
		section.main-hero
			h2.main-hero__title
				| 고객의 행복을 위해 <br>
				| 언제나 노력하는 #[strong NH농협]

		//- 통계
		section.main-stat
			.main-stat__inner
				h3.main-stat__title
					| 미래를 향한 든든한 동행, <br>
					| 00농협이 실현해 나가는 <br>
					| #[span.main-stat__highlight 4가지 핵심] 가치
				ul.stat-card-list
					each item in statCards
						+statCard(item.modifierClass, item.img, item.label, item.num, item.unit)

		//- 4가지 핵심가치
		section.main-value(data-animation="slideUp")
			.main-value__inner
				h3.main-value__title
					| 미래를 향한 든든한 동행, <br>
					| OO농협이 실현해 나가는 #[span.main-value__highlight 4가지 핵심 가치]
				ul.value-list(data-js="valueList")
					each item, i in valueCards
						- const valueClass = (i === 0) ? item.modifierClass + ' is-active' : item.modifierClass
						+valueCard(valueClass, item.img, item.icon, item.title, item.desc)

		//- News + 갤러리
		section.main-news(data-animation="slideUp")
			.main-news__inner
				.main-news__col.news
					.main-news__tt
						.main-news__text
							strong.main-news__title News
							p.main-news__desc 다양한 행사 정보 및 공지사항을 안내드립니다.
						a.main-news__more(href="#", aria-label="News 더보기")
							img(src="../img/icon/icon_plus_blue.svg", alt="")
					ul.news-list
						each item in newsList
							+newsItem(item.month, item.day, item.title, item.desc)

				.main-news__col.gallery
					.main-news__tt
						.main-news__text
							strong.main-news__title 갤러리
							p.main-news__desc 다양한 활동과 생생한 소식을 전해드립니다.
						a.main-news__more(href="#", aria-label="갤러리 더보기")
							img(src="../img/icon/icon_plus_blue.svg", alt="")
					ul.gallery-list
						each item in galleryList
							+galleryItem(item.img, item.title, item.desc)

		//- 채용 배너
		section.main-recruit(data-animation="slideUp")
			.main-recruit__wide
				.main-recruit__text
					h4.main-recruit__title
						| 당신과 함께 <br>
						| 성장할 내일을 기다립니다.
					p.main-recruit__desc
						| 현재 진행 중인 채용 공고를 확인하고, 당신의 역량을 펼칠 수 <br>
						| 있는 최적의 자리에 지원해 보세요.
					a.main-recruit__btn.white(href="#")
						| 채용정보 보러가기
						img(src="../img/icon/icon_link_black.svg", alt="")
				img.main-recruit__illust(src="../img/main/main3_recruit_illust.png", alt="")

			.main-recruit__side
				.main-recruit__card.guide
					.main-recruit__text
						h4.main-recruit__title
							| 처음부터 끝까지 <br>
							| 든든하게 안내합니다.
						p.main-recruit__desc 전형 절차와 지원 방법을 한눈에 확인하세요.
						a.main-recruit__btn.dark(href="#")
							| 채용안내 보러가기
							img(src="../img/icon/icon_link_white.svg", alt="")

				.main-recruit__card.welfare
					.main-recruit__text
						h4.main-recruit__title
							| 최고의 인재에게 <br>
							| 최고의 환경을 제공합니다.
						p.main-recruit__desc 공정한 성장과 다채로운 복지 혜택을 만나보세요.
						a.main-recruit__btn.dark(href="#")
							| 인사제도 및 복리후생 보러가기
							img(src="../img/icon/icon_link_white.svg", alt="")

		//- SNS
		section.main-sns(data-animation="slideUp")
			.main-sns__inner
				.main-sns__tt
					strong.main-sns__title OO농협 SNS
					p.main-sns__desc
						| 농협의 새로운 소식과 다양한 이야기를 <br>
						| SNS에서 확인해 보세요.
				ul.sns-card-list
					each item in snsCards
						+snsCard(item.modifierClass, item.icon, item.title)

		//- 계열사
		section.main-affiliate(data-animation="slideUp")
			.main-affiliate__inner
				.main-affiliate__tt
					strong.main-affiliate__title 계열사 소개
					p.main-affiliate__desc
						| 대한민국 농협의 미래를 함께하는 농협 계열사와 유관기관의 <br>
						| 다양한 정보와 서비스를 지금 바로 확인해 보세요.
					.main-affiliate__links
						a.main-affiliate__link(href="#")
							| 농협금융지주
						a.main-affiliate__link(href="#")
							| 농협중앙회

				ul.affiliate-list
					each item in affiliateList
						+affiliateItem(item.name, item.icon)

block bottomScripts
	script(src="../js/main.js")
